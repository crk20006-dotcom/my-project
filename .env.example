# ==============================================================================
# PROJECT GENESIS — LOCAL ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env for local development. No external AI API keys are required.
# ==============================================================================

# Frontend / Live Preview Server Host & Port (defaults to 127.0.0.1 locally)
HOST=127.0.0.1
PORT=3000

# Python FastAPI Backend Configuration (for separate Windows local development)
GENESIS_BACKEND_HOST=127.0.0.1
GENESIS_BACKEND_PORT=8000
VITE_API_BASE_URL=

# Local Persistent SQLite Database Path
GENESIS_DB_PATH=./data/genesis.db

# Optional Future Local Inference Server Endpoint (e.g., llama.cpp / vLLM / Genesis Core)
GENESIS_INFERENCE_URL=http://127.0.0.1:8080

# Local Security & Upload Policy
GENESIS_MAX_UPLOAD_MB=5
GENESIS_ALLOWED_EXTENSIONS=.txt,.md,.json,.csv,.py,.ts,.tsx,.js,.yaml,.yml,.log,.wav,.mp3,.ogg
